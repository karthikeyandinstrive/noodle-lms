{
  "name": "@lms/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@lms/rbac": "*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2"
  }
}
