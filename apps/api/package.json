    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@lms/db": "*",
    "@lms/rbac": "*",
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@scalar/fastify-api-reference": "^1.25.0",
