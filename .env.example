# ─── Copy to .env and adjust. Never commit real secrets. ──────────────────────

NODE_ENV=development

# Database. Leave empty in development to use the embedded Postgres (PGlite) in .data/.
# Production: a real PostgreSQL 15+ URL.
DATABASE_URL=
# DATABASE_URL=postgresql://lms:lms@localhost:5432/lms

# Redis (sessions cache, rate limiting). Optional in dev, required with >1 API replica.
REDIS_URL=
# REDIS_URL=redis://localhost:6379

# Public URL of the web app (CSRF origin checks, links in emails).
APP_URL=http://localhost:3000
# Where the web app proxies /api requests.
API_URL=http://localhost:4000
PORT=4000

# Tenancy: self-hosted uses DEFAULT_ORG_SLUG; SaaS resolves <slug>.BASE_DOMAIN and custom domains.
DEFAULT_ORG_SLUG=default
BASE_DOMAIN=localhost
SAAS_MODE=false
TRUST_PROXY=true

# Secrets (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
URL_SIGNING_SECRET=

# Sessions
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_DAYS=14

# Platform default file storage: local | s3 | minio | r2 (organizations can configure their own)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Allow storage endpoints on private networks (self-hosted MinIO). Keep false for SaaS.
ALLOW_PRIVATE_STORAGE_ENDPOINTS=false

# Email (logged to console when empty)
SMTP_URL=
MAIL_FROM="LMS <no-reply@example.com>"

# SaaS billing (platform Stripe account)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Seed (development)
SEED_PASSWORD=
